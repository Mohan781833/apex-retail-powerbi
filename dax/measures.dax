// Meridian HR Dashboard — DAX measures
// All measures live in the dedicated Measures table.

// ---------- Calculated columns (Employees) ----------

IsActive = Employees[employment_status] = "Active"

TenureBand =
SWITCH(TRUE(),
    Employees[tenure_years] < 1, "Under 1 year",
    Employees[tenure_years] < 3, "1 to 3 years",
    Employees[tenure_years] < 5, "3 to 5 years",
    Employees[tenure_years] < 10, "5 to 10 years",
    "10 plus years"
)

SalaryBand =
SWITCH(TRUE(),
    Employees[salary_gbp] < 25000, "Under 25k",
    Employees[salary_gbp] < 35000, "25k to 35k",
    Employees[salary_gbp] < 50000, "35k to 50k",
    Employees[salary_gbp] < 75000, "50k to 75k",
    "75k plus"
)

IsManager =
IF(Employees[job_level] IN {"Manager", "Senior Manager", "Director"}, TRUE(), FALSE())

// ---------- Date table ----------

DateTable =
ADDCOLUMNS(
    CALENDAR(DATE(2022,1,1), DATE(2025,12,31)),
    "Year", YEAR([Date]),
    "MonthNum", MONTH([Date]),
    "MonthName", FORMAT([Date], "MMMM"),
    "MonthShort", FORMAT([Date], "MMM"),
    "Quarter", "Q" & QUARTER([Date]),
    "YearMonth", FORMAT([Date], "YYYY-MM")
)

// ---------- Workforce ----------

Active Headcount = COUNTROWS(FILTER(Employees, Employees[IsActive] = TRUE()))

Total Headcount = COUNTROWS(Employees)

Attrition Rate % =
DIVIDE(
    COUNTROWS(FILTER(Employees, Employees[IsActive] = FALSE())),
    [Total Headcount],
    0
)

Total Salary Cost =
CALCULATE(SUM(Employees[salary_gbp]), Employees[IsActive] = TRUE())

Avg Salary =
CALCULATE(AVERAGE(Employees[salary_gbp]), Employees[IsActive] = TRUE())

// ---------- Performance ----------

Avg Performance Rating = AVERAGE(Performance[performance_rating])

High Performer % =
DIVIDE(
    COUNTROWS(FILTER(Performance, Performance[performance_rating] >= 4)),
    COUNTROWS(Performance),
    0
)

Bonus Eligible Count =
COUNTROWS(FILTER(Performance, Performance[bonus_eligible] = TRUE()))

Avg Target Achievement % = AVERAGE(Performance[target_achievement_pct])

// ---------- Attendance ----------

Avg Attendance Rate % = AVERAGE(Attendance[attendance_pct])

Total Days Absent = SUM(Attendance[days_absent])

Avg Days Absent Per Employee =
DIVIDE([Total Days Absent], [Active Headcount], 0)

// ---------- Training ----------

Training Cert Rate % =
DIVIDE(
    COUNTROWS(FILTER(Training, Training[certified] = TRUE())),
    COUNTROWS(Training),
    0
)

Certified Completions =
COUNTROWS(FILTER(Training, Training[certified] = TRUE()))

Avg Training Score = AVERAGE(Training[score_pct])

Courses Per Employee =
DIVIDE(COUNTROWS(Training), [Active Headcount], 0)

// ---------- RLS role filters (applied to Employees) ----------
// Sales Manager:             [department] = "Sales"
// Engineering Manager:       [department] = "Engineering"
// Operations Manager:        [department] = "Operations"
// Marketing Manager:         [department] = "Marketing"
// HR and Finance Manager:    [department] = "HR and Finance"
// Customer Service Manager:  [department] = "Customer Service"
// CHRO:                      (no filter)
